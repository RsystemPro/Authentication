# Required: use your own PostgreSQL connection details.
# Required PostgreSQL connection URL. No default; keep your own username, password, host, port, and database.
DATABASE_URL_SB=postgresql://USER:PASSWORD@127.0.0.1:5432/viraboard

# development | production | test
# Application mode: development, production, or test. Default: development.
NODE_ENV=development
# HTTP listening port; integer from 1 to 65535. Default: 3000.
PORT=3000

# Authentication always uses CORS_ORIGINS. Keep false in production.
# Allows broad development network origins. Keep false in production; authentication uses CORS_ORIGINS. Default: false.
NETWORK_ACCESS=false
# Comma-separated HTTP(S) origins, without paths or trailing slashes.
# Allowed browser origins, comma-separated; no paths or trailing slashes. Must include AUTH_FRONTEND_URL; production requires HTTPS. Default: http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Comma-separated choices: request,console
# Enabled logging targets: console, request, or both separated by a comma. Default: console.
LOG_TYPES=console
# log,error,warn,debug,verbose,fatal; omit to use environment-specific defaults.
# Enabled log levels: log,error,warn,debug,verbose,fatal. Defaults depend on NODE_ENV: development/test log,error,warn,debug; production log,error,warn,fatal.
LOG_LEVELS=log,error,warn,debug
# General HTTP rate-limit window in milliseconds; 60000 = 1 minute. Default: 60000.
THROTTLE_TTL_MS=60000
# Maximum requests per general HTTP rate-limit window. Default: 100.
THROTTLE_LIMIT=100

# Optional redis:// or rediss:// URL. When set, it takes precedence over
# REDIS_HOST, REDIS_PORT, REDIS_DATABASE, REDIS_USERNAME and REDIS_PASSWORD.
# Optional redis:// or rediss:// connection URL. When set, overrides host, port, database, username, and password below. Default: (unset).
REDIS_URL=
# Redis hostname or IPv4/IPv6 address; used when REDIS_URL is unset. Default: 127.0.0.1.
REDIS_HOST=127.0.0.1
# Redis TCP port; used when REDIS_URL is unset. Default: 6379.
REDIS_PORT=6379
# Non-negative Redis database index; used when REDIS_URL is unset. Default: 0.
REDIS_DATABASE=0
# Optional Redis ACL username; empty means unset. Used when REDIS_URL is unset. Default: (unset).
REDIS_USERNAME=
# Optional Redis password; empty means unset. Used when REDIS_URL is unset. Default: (unset).
REDIS_PASSWORD=
# Non-blank prefix for application Redis keys; isolates this application namespace. Default: mvt:.
REDIS_KEY_PREFIX=mvt:
# Redis connection timeout in milliseconds; 5000 = 5 seconds. Default: 5000.
REDIS_CONNECT_TIMEOUT_MS=5000
# Maximum reconnect retries before giving up; 0 disables retries. Default: 5.
REDIS_RECONNECT_MAX_RETRIES=5
# Non-blank Redis adapter channel prefix for Socket.IO; use the same value on cooperating application instances. Default: mvt:socket.io.
SOCKET_IO_REDIS_KEY=mvt:socket.io

# Required: generate locally with node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never use a copied/example signing secret.
# Required signing secret; no default. Use at least 32 random bytes encoded as base64url. Keep the existing secret to preserve token validity.
AUTH_JWT_SECRET=
# Expected JWT issuer URL; HTTPS is required in production. Default: http://localhost:3000.
AUTH_JWT_ISSUER=http://localhost:3000
# Expected JWT audience identifier used when signing and verifying access tokens. Default: viraboard-web.
AUTH_JWT_AUDIENCE=viraboard-web
# Frontend origin used for verification/reset links; must be in CORS_ORIGINS. Production requires HTTPS. Default: http://localhost:5173.
AUTH_FRONTEND_URL=http://localhost:5173
# Access-token lifetime in seconds; 600 = 10 minutes. Allowed range: 60-900. Default: 600.
AUTH_ACCESS_TTL_SECONDS=600
# Refresh-session idle timeout in seconds; 1209600 = 14 days. Must not exceed AUTH_SESSION_TTL_SECONDS. Default: 1209600.
AUTH_REFRESH_IDLE_SECONDS=1209600
# Absolute session lifetime in seconds; 2592000 = 30 days, regardless of refresh activity. Default: 2592000.
AUTH_SESSION_TTL_SECONDS=2592000
# Email-verification token lifetime in seconds; 86400 = 24 hours. Default: 86400.
AUTH_VERIFICATION_TTL_SECONDS=86400
# Password-reset token lifetime in seconds; 900 = 15 minutes. Default: 900.
AUTH_RESET_TTL_SECONDS=900

# Omit AUTH_COOKIE_SECURE for environment defaults (true in production).
# For HTTPS development set true; SameSite=none always requires Secure.
# Refresh cookie SameSite policy: lax, strict, or none. The none policy requires AUTH_COOKIE_SECURE=true. Default: lax.
AUTH_COOKIE_SAME_SITE=lax
# Argon2id memory per hash in KiB; 19456 = 19 MiB. Allowed range: 19456-262144. Default: 19456.
AUTH_ARGON_MEMORY_KIB=19456
# Argon2id iteration count; allowed range: 2-10. Higher values increase hashing time. Default: 2.
AUTH_ARGON_TIME_COST=2
# Enable known-breached-password screening where used by password validation. Must be true in production. Default: true.
AUTH_PWNED_PASSWORDS_ENABLED=true

# Production requires SMTP and HTTPS issuer/frontend/CORS URLs.
# Configure a real mail transport; no verification/reset links are printed.
# SMTP transport URL (smtp:// or smtps://); unset by default. Required in production. Without a transport, authentication emails are not sent.
# AUTH_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# Sender address, optionally with a display name. Runtime fallback: ViraBoard <no-reply@localhost>. Set a valid sender explicitly in production.
AUTH_MAIL_FROM=ViraBoard <no-reply@example.com>

# IPs/CIDRs of actual reverse proxies only; omit for direct connections.
# Trusted reverse-proxy IP addresses/CIDRs only. Unset means direct connections; do not trust arbitrary proxies.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Login and token-confirmation rate-limit window in milliseconds; 900000 = 15 minutes. Default: 900000.
AUTH_RATE_WINDOW_MS=900000
# Shared registration/resend/forgot-password email window in milliseconds; 3600000 = 1 hour. Default: 3600000.
AUTH_EMAIL_RATE_WINDOW_MS=3600000
# Refresh-token rate-limit window in milliseconds; 60000 = 1 minute. Default: 60000.
AUTH_REFRESH_RATE_WINDOW_MS=60000
# Maximum login requests per IP during AUTH_RATE_WINDOW_MS. Default: 20.
AUTH_LOGIN_IP_LIMIT=20
# Maximum login requests per normalized account identity during AUTH_RATE_WINDOW_MS. Default: 10.
AUTH_LOGIN_ACCOUNT_LIMIT=10
# Registration requests per IP during the shared email window. Default: 5.
AUTH_REGISTER_IP_LIMIT=5
# Shared registration/resend/forgot-password requests per account during the email window. Default: 3.
AUTH_EMAIL_ACCOUNT_LIMIT=3
# Resend/forgot-password requests per IP during the shared email window. Default: 10.
AUTH_EMAIL_IP_LIMIT=10
# Maximum refresh requests per IP during AUTH_REFRESH_RATE_WINDOW_MS. Default: 60.
AUTH_REFRESH_IP_LIMIT=60
# Maximum refresh requests per refresh identity during AUTH_REFRESH_RATE_WINDOW_MS. Default: 30.
AUTH_REFRESH_TOKEN_LIMIT=30
# Verification/reset token-confirmation attempts per IP and token identity during AUTH_RATE_WINDOW_MS. Default: 10.
AUTH_TOKEN_ATTEMPT_LIMIT=10
# Days to retain stale authentication session/token records before pruning; allowed range: 1-90. Default: 30.
AUTH_RETENTION_DAYS=30
# Days to retain authentication security events before pruning; allowed range: 1-365. Default: 90.
AUTH_AUDIT_RETENTION_DAYS=90

# Test commands require a dedicated, migrated local test database.
# Optional test-only PostgreSQL URL; no default. Must target a migrated local viraboard_auth_test database (or a suffixed variant), never the application database.
# AUTH_TEST_DATABASE_URL_SB=postgresql://USER:PASSWORD@127.0.0.1:5432/viraboard_auth_test

# Additional settings: defaults are active; optional settings without a fixed default stay commented.

# --- Cookies and password protection ---
# Cookie HTTPS requirement. Default: automatic (false in development/test, true in production). Leave commented to retain automatic behavior.
# AUTH_COOKIE_SECURE=false
